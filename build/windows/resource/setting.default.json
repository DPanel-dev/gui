{
  "Apps": [
    {
      "HomeUrl": "${HOME_URL}:${APP_SERVER_PORT}",
      "Name": "dpanel",
      "RunOption": {
        "AutoLaunch": true,
        "Environment": [
          "APP_SERVER_PORT=8086",
          "STORAGE_LOCAL_PATH=${DP_HOME_DIR}\\dpanel",
          "HOME_URL=http://127.0.0.1"
        ],
        "LogMaxLine": 1000,
        "StartCommand": "./dpanel server:start",
        "StopCommand": "",
        "WorkDir": ".\\apps\\dpanel"
      },
      "Setting": {
        "Environment": {
          "APP_SERVER_PORT": {
            "Description": "服务运行端口"
          },
          "HOME_URL": {
            "Description": "访问地址"
          },
          "STORAGE_LOCAL_PATH": {
            "Description": "数据存储目录"
          }
        }
      }
    }
  ],
  "System": {
    "CloseWindowHide": false,
    "Theme": "light"
  }
}
