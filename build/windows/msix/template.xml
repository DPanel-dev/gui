<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dpanel-desktop.exe"
        Arguments=""
        InstallLocation="C:\Program Files\DPanel\DPanel Desktop">
    </Installer>
    <PackageInformation
        PackageName="DPanel Desktop"
        PackageDisplayName="DPanel Desktop"
        PublisherName="CN=DPanel"
        PublisherDisplayName="DPanel"
        Version="1.0.0.0"
        PackageDescription="DPanel Desktop Manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.dpanel.dpanel-desktop"
                Description="DPanel Desktop Manager"
                DisplayName="DPanel Desktop"
                ExecutableName="dpanel-desktop.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>DPanel Desktop</DisplayName>
            <PublisherDisplayName>DPanel</PublisherDisplayName>
            <Description>DPanel Desktop Manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dpanel-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
