{
  "Apps": [
      {
        "HomeUrl": "${DP_HOME_URL}:${APP_SERVER_PORT}",
        "Name": "dpanel",
        "RunOption": {
          "AutoLaunch": true,
          "Environment": [
            "APP_SERVER_PORT=9999",
            "DP_SYSTEM_STORAGE_LOCAL_PATH=${DP_HOME_DIR}/dpanel",
            "DP_HOME_URL=http://127.0.0.1"
          ],
          "LogMaxLine": 1000,
          "StartCommand": "./dpanel server:start",
          "StopCommand": "",
          "WorkDir": "./apps/dpanel"
        },
        "Setting": {
          "Environment": {
            "APP_SERVER_PORT": {
              "Description": {
                "zh-CN": "服务运行端口",
                "en-US": "Service port"
              }
            },
            "DP_HOME_URL": {
              "Description": {
                "zh-CN": "访问地址",
                "en-US": "Access address"
              }
            },
            "DP_SYSTEM_STORAGE_LOCAL_PATH": {
              "Description": {
                "zh-CN": "数据存储目录",
                "en-US": "Data storage directory"
              },
              "Help": {
                "zh-CN": "数据存储目录为 ${DP_HOME_DIR}/dpanel；如需更改，请在启动桌面程序前设置 DP_HOME_DIR 环境变量。",
                "en-US": "Data is stored in ${DP_HOME_DIR}/dpanel. To change it, set DP_HOME_DIR before starting the desktop app."
              },
              "Disabled": true
            }
          }
        }
      },
      {
        "HomeUrl": "http://127.0.0.1",
        "Name": "nginx",
        "RunOption": {
          "AutoLaunch": false,
          "Environment": null,
          "LogMaxLine": 0,
          "StartCommand": "./nginx",
          "StopCommand": "taskkill /F /IM nginx.exe",
          "WorkDir": "./apps/nginx-1.29.1"
        },
        "Setting": {
          "Environment": null
        }
      },
      {
        "Name": "xray",
        "RunOption": {
          "AutoLaunch": false,
          "Environment": null,
          "LogMaxLine": 0,
          "StartCommand": "./xray -config ./config.json",
          "StopCommand": "",
          "WorkDir": "./apps/Xray-windows-64"
        },
        "Setting": {
          "Environment": null
        }
      }
    ],
    "System": {
      "CloseWindowHide": true,
      "Theme": "light",
      "Language": "auto"
    }
}
