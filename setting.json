{
  "Apps": [
      {
        "HomeUrl": "${DP_HOME_URL}:${APP_SERVER_PORT}",
        "Name": "dpanel",
        "RunOption": {
          "AutoLaunch": true,
          "Environment": [
            "APP_SERVER_PORT=9999",
            "DP_HOME_URL=http://127.0.0.1",
            "DP_SYSTEM_STORAGE_LOCAL_PATH=${DP_DATA_DIR}/dpanel"
          ],
          "LogMaxLine": 1000,
          "StartCommand": "./dpanel server:start",
          "StopCommand": "",
          "WorkDir": "./apps/dpanel"
        },
        "Setting": {
          "Environment": {
            "APP_SERVER_PORT": {
              "Description": "服务运行端口"
            },
            "DP_HOME_URL": {
              "Description": "访问地址"
            },
            "DP_SYSTEM_STORAGE_LOCAL_PATH": {
              "Description": "数据存储目录"
            }
          }
        }
      },
      {
        "HomeUrl": "http://127.0.0.1",
        "Name": "nginx",
        "RunOption": {
          "AutoLaunch": false,
          "Environment": null,
          "LogMaxLine": 0,
          "StartCommand": "./nginx",
          "StopCommand": "taskkill /F /IM nginx.exe",
          "WorkDir": "./apps/nginx-1.29.1"
        },
        "Setting": {
          "Environment": null
        }
      },
      {
        "Name": "xray",
        "RunOption": {
          "AutoLaunch": false,
          "Environment": null,
          "LogMaxLine": 0,
          "StartCommand": "./xray -config ./config.json",
          "StopCommand": "",
          "WorkDir": "./apps/Xray-windows-64"
        },
        "Setting": {
          "Environment": null
        }
      }
    ],
    "System": {
      "CloseWindowHide": true,
      "Theme": "light"
    }
}
